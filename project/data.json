 "last_three_years_board_exam_results": "documents/1692601589976-sse-result.pdf", "principal": "Sr AnnMary SIC", "total_no_of_teachers": 30, "pgt_teachers": 10, "tgt_teachers": 10, "prt_teachers": 9, "teachers_section_ratio": 76.0, "details_of_special_educator": "Mohan", "details_of_counsellor_and_wellness_teacher": "Kumar", "total_campus_area": 18874.41, "no_and_size_of_classrooms": "17", "no_and_size_of_laboratories": "5", "internet_facility": true, "no_of_girls_toilets": 20, "no_of_boys_toilets": 10, "youtube_link_of_inspection_video": null}}, {"model": "Home.facility", "pk": 1, "fields": {"name": "Laboratories", "description": "Our science lab is a place where our students can conduct hands-on experiments and explore the world of science. Our lab is equipped with all the necessary tools and equipment to conduct experiments in biology, chemistry, and physics. We believe that hands-on learning is an essential part of science education, and we provide our students with the resources they need to succeed.", "image": "facility_images/iStock-506712124-1380x1035.jpg", "uploaded_at": "2024-05-28T09:03:41.900Z"}}, {"model": "Home.facility", "pk": 3, "fields": {"name": "Library", "description": "Our school library is a valuable resource for students, offering access to books, magazines, and digital resources. With a quiet and comfortable environment, students can focus on their studies or enjoy a good book. The librarians are knowledgeable and helpful, assisting students in finding the resources they need. The library plays a crucial role in promoting lifelong learning and academic success.", "image": "facility_images/library_DAztaYY.jpg", "uploaded_at": "2024-05-28T09:20:13.572Z"}}, {"model": "Home.album", "pk": 5, "fields": {"title": "Tour", "created_at": "2024-05-28T15:23:16.270Z"}}, {"model": "Home.album", "pk": 6, "fields": {"title": "Sports", "created_at": "2024-05-28T15:26:53.063Z"}}, {"model": "Home.album", "pk": 7, "fields": {"title": "Yoga & Karate", "created_at